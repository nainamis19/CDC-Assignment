#include<bits/stdc++.h>
using namespace std;
void movezeroes(vector<int>&arr){
    int n=arr.size();
    int i=0;
    for(int j=0;j<n;j++){
        if(arr[j]!=0){
            swap(arr[j],arr[i]);
            i++;
        }
    }
}
int main(){
    vector<int>nums={0,1,0,3,12};
    movezeroes(nums);
    for(int x:nums){
        cout<<x<<" ";
    }
    return 0;

}
